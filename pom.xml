<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hu.bme</groupId>
    <artifactId>nim</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>NIM – Grundy AI</name>
    <description>NIM játék Grundy-számok (Sprague–Grundy) alapján döntő AI ellenféllel, JavaFX felülettel.</description>
    <url>https://github.com/VarMattew/nim</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.6</javafx.version>
        <junit.version>5.11.4</junit.version>
        <main.class>hu.bme.nim.App</main.class>

        <!-- jpackage beállítások (release profil) -->
        <app.name>NIM</app.name>
        <app.vendor>BME VIK</app.vendor>
        <app.description>NIM játék Grundy-számos gépi ellenféllel</app.description>
        <!-- MSI-hez szigorúan X.Y.Z alakú kell, SNAPSHOT nélkül -->
        <app.version>${project.version}</app.version>
        <!-- app-image: telepítő nélküli, hordozható mappa (nem kell WiX); msi/exe: telepítő (WiX Toolset 3.x kell) -->
        <jpackage.type>app-image</jpackage.type>
        <jpackage.modules>java.base,java.desktop,java.logging,java.xml,java.scripting,java.naming,java.prefs,java.datatransfer,jdk.unsupported</jpackage.modules>
        <!-- ezeket a lenti, automatikusan aktiválódó profilok töltik ki -->
        <jpackage.icon.args></jpackage.icon.args>
        <jpackage.installer.args></jpackage.installer.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!-- Futtatható jar manifesttel; a launcher (App) nem Application-leszármazott, így classpath-ról is indul -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- API-dokumentáció: mvn javadoc:javadoc  →  target/reports/apidocs/index.html -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <doclint>all</doclint>
                    <failOnWarnings>false</failOnWarnings>
                    <failOnError>true</failOnError>
                    <show>protected</show>
                    <doctitle>NIM – Grundy-számos ellenfél ${project.version}</doctitle>
                    <windowtitle>NIM API</windowtitle>
                    <bottom><![CDATA[BME VIK · Algoritmikus Játékelmélet · szorgalmi feladat]]></bottom>
                    <links>
                        <link>https://openjfx.io/javadoc/21/</link>
                    </links>
                </configuration>
            </plugin>
            <!-- Futtatás fejlesztés közben: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Windows release:  mvn clean package -P release
              → target/dist/NIM/NIM.exe            (hordozható mappa, beágyazott Java-futtatókörnyezettel)
            Telepítő (WiX Toolset 3.x szükséges):  mvn clean package -P release -Djpackage.type=msi
              → target/dist/NIM-1.0.0.msi
            Ikon: ha létezik packaging/windows/nim.ico, automatikusan bekerül.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- 1) minden futásidejű függőség (JavaFX + natív Windows DLL-ek) egy mappába -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-deps</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- 2) az alkalmazás jar-ja is a libs mappába -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.2</version>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                        </configuration>
                    </plugin>
                    <!-- 3) jpackage a JDK-ból: natív Windows alkalmazás beágyazott, jlink-elt futtatókörnyezettel -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <commandlineArgs>--type ${jpackage.type} --name "${app.name}" --app-version ${app.version} --vendor "${app.vendor}" --description "${app.description}" --input "${project.build.directory}/libs" --main-jar ${project.build.finalName}.jar --main-class ${main.class} --add-modules ${jpackage.modules} --dest "${project.build.directory}/dist" --java-options -Dfile.encoding=UTF-8 ${jpackage.icon.args} ${jpackage.installer.args}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Ikon csak akkor, ha a fájl létezik (packaging/windows/nim.ico) -->
        <profile>
            <id>release-icon</id>
            <activation>
                <file>
                    <exists>${basedir}/packaging/windows/nim.ico</exists>
                </file>
            </activation>
            <properties>
                <jpackage.icon.args>--icon "${project.basedir}/packaging/windows/nim.ico"</jpackage.icon.args>
            </properties>
        </profile>
        <!-- Telepítő-specifikus kapcsolók csak MSI/EXE típusnál (app-image-nél a jpackage elutasítaná őket) -->
        <profile>
            <id>release-msi</id>
            <activation>
                <property>
                    <name>jpackage.type</name>
                    <value>msi</value>
                </property>
            </activation>
            <properties>
                <jpackage.installer.args>--win-menu --win-menu-group BME --win-shortcut --win-dir-chooser --win-per-user-install</jpackage.installer.args>
            </properties>
        </profile>
        <profile>
            <id>release-exe</id>
            <activation>
                <property>
                    <name>jpackage.type</name>
                    <value>exe</value>
                </property>
            </activation>
            <properties>
                <jpackage.installer.args>--win-menu --win-menu-group BME --win-shortcut --win-dir-chooser --win-per-user-install</jpackage.installer.args>
            </properties>
        </profile>
    </profiles>
</project>
